{
  "name": "balancesys",
  "version": "0.1.0",
  "description": "BalanceSys — sistema de controle financeiro pessoal.",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "dev": "ts-node src/main.ts",
    "build": "tsc && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "start": "node dist/src/main.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.6",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
