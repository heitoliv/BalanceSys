generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String      @id @default(uuid())
  nome      String
  email     String      @unique
  emailBusca String      @unique
  senhaHash String?
  emailVerificadoEm DateTime?
  criadoEm  DateTime    @default(now())

  transacoes Transacao[]
  sessoes    Sessao[]
  tokens     TokenConta[]
  metas      MetaGasto[]

  @@map("usuarios")
}

model TokenConta {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  tipo      String
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo, criadoEm])
  @@index([expiraEm])
  @@map("tokens_conta")
}

model Sessao {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  csrfToken String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

/// Classificação da transação (RN02). Semeada com um conjunto inicial fixo.
model Categoria {
  id    String  @id @default(uuid())
  nome  String  @unique
  tipo  String  // "RECEITA" | "DESPESA" | "AMBOS" — restringe uso por tipo

  transacoes Transacao[]
  metas MetaGasto[]

  @@map("categorias")
}

model MetaGasto {
  id String @id @default(uuid())
  usuarioId String
  categoriaId String
  mes String
  limite Decimal @db.Decimal(18, 2)
  moeda String @default("BRL")
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@unique([usuarioId, categoriaId, mes])
  @@index([usuarioId, mes])
  @@map("metas_gasto")
}

/// Movimentação financeira — entidade central do domínio (ADR-01).
/// Concentra as regras RN01 (prioridade) e é a origem do cálculo de saldo.
model Transacao {
  id          String   @id @default(uuid())
  tipo        String   // "RECEITA" | "DESPESA"
  valor       Decimal  @db.Decimal(18, 2)
  descricao   String
  data        DateTime
  prioridade  String   // "ESSENCIAL" | "IMPORTANTE" | "OPCIONAL" (RN01)
  criadoEm    DateTime @default(now())

  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@index([usuarioId, data])
  @@index([usuarioId, tipo, data])
  @@index([usuarioId, categoriaId, data])
  @@map("transacoes")
}
